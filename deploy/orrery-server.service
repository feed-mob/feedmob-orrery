# Orrery 控制面。
#
#   install -m 0755 bin/orrery-server /usr/local/bin/
#   install -m 0600 deploy/orrery-server.env /etc/orrery/server.env   # 改成你自己的值
#   install -m 0644 deploy/orrery-server.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now orrery-server
[Unit]
Description=Orrery control plane
Documentation=https://github.com/feed-mob/feedmob-orrery
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=orrery
Group=orrery
# 密钥从文件读，不进命令行——命令行任何人一个 ps 就看到了。
EnvironmentFile=/etc/orrery/server.env
ExecStart=/usr/local/bin/orrery-server -db /var/lib/orrery/orrery.db -addr 127.0.0.1:8080
Restart=always
RestartSec=5s
StateDirectory=orrery
StateDirectoryMode=0700
WorkingDirectory=/var/lib/orrery

# 控制面不跑任何用户代码，所以可以收得很紧。runner 不行——见 orrery-runner.service。
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
ReadWritePaths=/var/lib/orrery

[Install]
WantedBy=multi-user.target
