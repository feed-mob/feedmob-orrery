# /etc/orrery/server.env —— chmod 0600，属主 root。
# 这些值都是密钥：命令行会出现在 ps 里，环境变量文件不会。

# runner 首次注册时出示一次
ORRERY_REGISTRATION_TOKEN=

# 人与 CLI 访问 API 和面板用的令牌。没有它服务端拒绝启动。
ORRERY_API_TOKEN=

# 读 workflow 文件、回写 commit status
ORRERY_FORGE_TOKEN=

# GitHub webhook 里填的同一个值
ORRERY_WEBHOOK_SECRET=

# commit status 点过去的地址
ORRERY_PUBLIC_URL=https://orrery.example.com

# 只构建这些仓库。留空等于「任何签名 webhook 声称的仓库」。
ORRERY_REPOS=feed-mob/app,feed-mob/feedmob-orrery

# workflow verdict 变化时通知到哪
ORRERY_NOTIFY_WEBHOOK=

# 注入给每个 job 的密钥，一行一个 KEY=VALUE，绝不落库
# （用 -secrets /etc/orrery/secrets.env 指过去）
